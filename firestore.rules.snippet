// ============================================================================
// Firestore rules — complete replacement for project my-webapp-bb4f8
// ============================================================================
//
// This is your EXISTING ruleset, unchanged, plus the two collections that were
// missing. Firestore denies by default anything unmatched, so both of these
// were silently failing:
//
//   equipment_groups      - read+write denied -> the custom group feature
//   settings_gs_divisions - read+write denied -> gsDivisions always [] ->
//                           the "Enroll New Staff" GS Division dropdown was
//                           empty, so GNs could not be created with a division
//
// Every pre-existing rule is preserved verbatim. Nothing is loosened beyond
// what the app already assumes: Firestore allow rules are additive, and
// applications/users/settings already allowed any signed-in user to write.
//
// Verified against the app: role is stored as exactly "admin" (confirmed by
// the in-app diagnostic), so the existing isAdmin() helper is correct as
// written. No case-insensitive handling is needed.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is an admin
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Settings Collection (Permission for Policy and Divisions)
    match /settings/{docId} {
      allow read: if request.auth != null;
      // ONLY the Admin can change the grant percentage/cap
      allow write: if request.auth != null && isAdmin();
    }

    // User Registry (Permission to manage staff)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (isAdmin() || request.auth.uid == userId);
    }

    // Applications & Sectors (Needed for general operations)
    match /applications/{docId} {
      allow read, write: if request.auth != null;
    }

    match /settings_divisions/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    match /settings_sectors/{docId} {
      allow read, write: if request.auth != null;
    }

    // --- ADDED: Grama Niladhari divisions managed from the Sectors tab ------
    // Readable by any signed-in user because the staff-enrolment modal and the
    // per-user GS Division dropdowns are populated from this collection.
    match /settings_gs_divisions/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    // --- ADDED: Custom equipment groups (Equipment Group Procurement) -------
    // Readable by any signed-in user so the Accounts / Procurement department
    // can open a group created by Admin. Change `allow read` to
    // `isAdmin()` if the saved-group list should stay admin-only.
    match /equipment_groups/{groupId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }
  }
}
